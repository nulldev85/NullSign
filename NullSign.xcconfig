// NullSign release identity. Keep version values here so local and CI builds agree.
NULLSIGN_MARKETING_VERSION = 1.2.1
NULLSIGN_BUILD_NUMBER = 12
NULLSIGN_PRODUCT_BUNDLE_IDENTIFIER = com.elmat.NullSign
NULLSIGN_DISAMBIGUATOR = $(DEVELOPMENT_TEAM)

AD_HOC_CODE_SIGNING_ALLOWED = YES

DEPLOYMENT_LOCATION = YES
DSTROOT = $(SRCROOT)/_build/
