new file mode 100644
--- /dev/null
+++ b/src/certificate_validation.h
@@ -0,0 +1,103 @@
+#pragma once
+
+#include "common/json.h"
+#include <memory>
+#include <openssl/cms.h>
+#include <openssl/err.h>
+#include <openssl/pkcs12.h>
+#include <openssl/provider.h>
+
+// Loading any provider disables automatic loading of the default provider.
+// Retain both handles for the process lifetime; initialize once across threads.
+inline bool ZInitializeCertificateProviders()
+{
+	static const bool ready = [] {
+		OSSL_PROVIDER* standard = OSSL_PROVIDER_load(nullptr, "default");
+		OSSL_PROVIDER_load(nullptr, "legacy");
+		// Legacy is optional: modern identities work even if it is unavailable.
+		ERR_clear_error();
+		return standard != nullptr;
+	}();
+	return ready;
+}
+
+enum class ZCertificateValidation {
+	valid,
+	unavailableAlgorithms,
+	unreadableCertificate,
+	invalidCertificate,
+	incorrectPassword,
+	decryptionFailed,
+	missingPrivateKey,
+	unreadableProfile,
+	invalidProfile,
+	profileMismatch
+};
+
+template <typename T, auto Free>
+using ZCertificatePointer = std::unique_ptr<T, decltype(Free)>;
+
+inline ZCertificateValidation ZReadProvisioningContent(const char* path, std::string& content)
+{
+	content.clear();
+	ZCertificatePointer<BIO, BIO_free> input(BIO_new_file(path, "rb"), BIO_free);
+	if (!input) return ZCertificateValidation::unreadableProfile;
+	ZCertificatePointer<CMS_ContentInfo, CMS_ContentInfo_free> cms(
+		d2i_CMS_bio(input.get(), nullptr), CMS_ContentInfo_free);
+	if (!cms || OBJ_obj2nid(CMS_get0_type(cms.get())) != NID_pkcs7_signed)
+		return ZCertificateValidation::invalidProfile;
+	ASN1_OCTET_STRING** payload = CMS_get0_content(cms.get());
+	if (!payload || !*payload || ASN1_STRING_length(*payload) <= 0)
+		return ZCertificateValidation::invalidProfile;
+	content.assign(reinterpret_cast<const char*>(ASN1_STRING_get0_data(*payload)),
+		ASN1_STRING_length(*payload));
+	return ZCertificateValidation::valid;
+}
+
+inline ZCertificateValidation ZValidateCertificate(
+	const char* path, const char* password, const char* profilePath = nullptr)
+{
+	ERR_clear_error();
+	if (!ZInitializeCertificateProviders()) return ZCertificateValidation::unavailableAlgorithms;
+	ZCertificatePointer<BIO, BIO_free> input(BIO_new_file(path, "rb"), BIO_free);
+	if (!input) return ZCertificateValidation::unreadableCertificate;
+	ZCertificatePointer<PKCS12, PKCS12_free> p12(d2i_PKCS12_bio(input.get(), nullptr), PKCS12_free);
+	if (!p12) return ZCertificateValidation::invalidCertificate;
+	// MAC verification alone does not prove the private key can be decrypted.
+	// Only try a null password when the supplied password is actually empty.
+	if (PKCS12_mac_present(p12.get()) &&
+		!PKCS12_verify_mac(p12.get(), password, -1) &&
+		!(password[0] == '\0' && PKCS12_verify_mac(p12.get(), nullptr, 0)))
+		return ZCertificateValidation::incorrectPassword;
+	ERR_clear_error();
+	EVP_PKEY* rawKey = nullptr;
+	X509* rawCertificate = nullptr;
+	const int parsed = PKCS12_parse(p12.get(), password, &rawKey, &rawCertificate, nullptr);
+	ZCertificatePointer<EVP_PKEY, EVP_PKEY_free> key(rawKey, EVP_PKEY_free);
+	ZCertificatePointer<X509, X509_free> certificate(rawCertificate, X509_free);
+	if (!parsed) return ZCertificateValidation::decryptionFailed;
+	if (!key || (certificate && !X509_check_private_key(certificate.get(), key.get())))
+		return ZCertificateValidation::missingPrivateKey;
+	if (!profilePath) return ZCertificateValidation::valid;
+
+	std::string content;
+	const auto profileResult = ZReadProvisioningContent(profilePath, content);
+	if (profileResult != ZCertificateValidation::valid) return profileResult;
+	jvalue profile;
+	if (!profile.read_plist(content) || !profile["DeveloperCertificates"].is_array() ||
+		profile["DeveloperCertificates"].size() == 0)
+		return ZCertificateValidation::invalidProfile;
+	for (size_t index = 0; index < profile["DeveloperCertificates"].size(); ++index) {
+		const std::string der = profile["DeveloperCertificates"][index].as_data();
+		const auto* bytes = reinterpret_cast<const unsigned char*>(der.data());
+		ZCertificatePointer<X509, X509_free> candidate(
+			d2i_X509(nullptr, &bytes, static_cast<long>(der.size())), X509_free);
+		if (candidate && X509_check_private_key(candidate.get(), key.get()) &&
+			(!certificate || X509_cmp(certificate.get(), candidate.get()) == 0)) {
+			ERR_clear_error();
+			return ZCertificateValidation::valid;
+		}
+	}
+	ERR_clear_error();
+	return ZCertificateValidation::profileMismatch;
+}
